# Used by docker compose. For `pnpm dev`, copy apps/store/.env.example to apps/store/.env.local.

# Public addresses, inlined at build time: rebuild after changing them.
STORE_URL=http://localhost:3000
SIMULATOR_URL=http://localhost:3001

# Where the containers listen on this machine. 0.0.0.0 to reach them from the network.
BIND_ADDRESS=127.0.0.1
STORE_PORT=3000
SIMULATOR_PORT=3001

# Orders and questions. Digits only, with the country code: 628123456789.
WHATSAPP_NUMBER=
# Defaults to the address in packages/catalog/src/brand.ts.
CONTACT_EMAIL=

# Marketplace store pages; each button appears once its link is set.
TOKOPEDIA_URL=
SHOPEE_URL=

# PT Ezra Robotics Teknologi, the exclusive seller of Ciko and Momo: WhatsApp first, then email,
# then the website. With none set, questions about those robots come to the contacts above.
EZRA_WHATSAPP_NUMBER=
EZRA_EMAIL=
EZRA_URL=
